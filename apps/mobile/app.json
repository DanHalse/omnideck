{
  "expo": {
    "name": "OmniDeck",
    "slug": "omnideck-mobile",
    "version": "1.4.1",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0F12"
    },
    "android": {
      "package": "dev.omnideck.mobile",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0D0F12"
      },
      "permissions": [
        "INTERNET",
        "WAKE_LOCK",
        "MODIFY_AUDIO_SETTINGS",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      "./plugins/withAndroidDrmWebView"
    ]
  }
}
