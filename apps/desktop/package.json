{
  "name": "@omnideck/desktop",
  "version": "1.5.3",
  "private": true,
  "description": "OmniDeck Desktop — Widevine DRM-enabled multi-service media hub for Windows and Linux",
  "author": "OmniDeck Contributors <support@omnideck.dev>",
  "homepage": "https://github.com/DanHalse/omnideck",
  "repository": "https://github.com/DanHalse/omnideck.git",
  "desktopName": "omnideck.desktop",
  "main": "dist-electron/main.js",
  "scripts": {
    "setup:electron": "install-electron",
    "dev": "install-electron && concurrently -k -n vite,electron \"npm run dev:renderer\" \"npm run build:main && wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "dev:renderer": "vite",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.main.json --noEmit",
    "test": "vitest run",
    "package:linux": "npm run build && electron-builder --linux --config electron-builder.yml",
    "package:win": "npm run build && electron-builder --win --config electron-builder.yml"
  },
  "dependencies": {
    "@omnideck/shared": "*",
    "electron-updater": "^6.8.11",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.9.0",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "https://github.com/castlabs/electron-releases#v45.2.1+wvcus",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wait-on": "^8.0.3"
  }
}
